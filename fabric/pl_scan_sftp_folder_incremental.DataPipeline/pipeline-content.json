{
  "properties": {
    "activities": [
      {
        "type": "GetMetadata",
        "typeProperties": {
          "datasetSettings": {
            "type": "Binary",
            "typeProperties": {
              "location": {
                "type": "SftpLocation",
                "folderPath": {
                  "value": "@pipeline().parameters.p_current_source_path",
                  "type": "Expression"
                }
              }
            },
            "externalReferences": {
              "connection": "@json(pipeline().parameters.p_source_connection_settings).connectionId"
            },
            "annotations": []
          },
          "fieldList": [
            "childItems"
          ],
          "storeSettings": {
            "type": "SftpReadSettings",
            "recursive": false
          },
          "formatSettings": {
            "type": "BinaryReadSettings"
          }
        },
        "policy": {
          "timeout": "0.12:00:00",
          "retry": 2,
          "retryIntervalInSeconds": 30,
          "secureInput": false,
          "secureOutput": false
        },
        "name": "gm_folder_children",
        "dependsOn": []
      },
      {
        "type": "Filter",
        "typeProperties": {
          "items": {
            "value": "@activity('gm_folder_children').output.childItems",
            "type": "Expression"
          },
          "condition": {
            "value": "@equals(item().type, 'Folder')",
            "type": "Expression"
          }
        },
        "name": "flt_child_folders",
        "dependsOn": [
          {
            "activity": "gm_folder_children",
            "dependencyConditions": [
              "Succeeded"
            ]
          }
        ]
      },
      {
        "type": "ForEach",
        "typeProperties": {
          "isSequential": true,
          "items": {
            "value": "@activity('flt_child_folders').output.value",
            "type": "Expression"
          },
          "activities": [
            {
              "type": "AppendVariable",
              "typeProperties": {
                "variableName": "v_child_folders",
                "value": {
                  "value": "@concat(pipeline().parameters.p_current_source_path, item().name, '/')",
                  "type": "Expression"
                }
              },
              "name": "append_child_folder",
              "dependsOn": []
            }
          ]
        },
        "name": "fe_child_folders",
        "dependsOn": [
          {
            "activity": "flt_child_folders",
            "dependencyConditions": [
              "Succeeded"
            ]
          }
        ]
      },
      {
        "type": "GetMetadata",
        "typeProperties": {
          "datasetSettings": {
            "type": "Binary",
            "typeProperties": {
              "location": {
                "type": "SftpLocation",
                "folderPath": {
                  "value": "@pipeline().parameters.p_current_source_path",
                  "type": "Expression"
                }
              }
            },
            "externalReferences": {
              "connection": "@json(pipeline().parameters.p_source_connection_settings).connectionId"
            },
            "annotations": []
          },
          "fieldList": [
            "childItems"
          ],
          "storeSettings": {
            "type": "SftpReadSettings",
            "recursive": false,
            "modifiedDatetimeStart": {
              "value": "@pipeline().parameters.p_processing_lower_bound",
              "type": "Expression"
            },
            "modifiedDatetimeEnd": {
              "value": "@pipeline().parameters.p_processing_upper_bound",
              "type": "Expression"
            }
          },
          "formatSettings": {
            "type": "BinaryReadSettings"
          }
        },
        "policy": {
          "timeout": "0.12:00:00",
          "retry": 2,
          "retryIntervalInSeconds": 30,
          "secureInput": false,
          "secureOutput": false
        },
