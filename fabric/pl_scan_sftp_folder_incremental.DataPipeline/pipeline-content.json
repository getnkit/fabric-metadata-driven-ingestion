        "dependsOn": [
          {
            "activity": "fe_child_folders",
            "dependencyConditions": [
              "Succeeded"
            ]
          }
        ]
      },
      {
        "type": "Filter",
        "typeProperties": {
          "items": {
            "value": "@activity('gm_candidate_files').output.childItems",
            "type": "Expression"
          },
          "condition": {
            "value": "@and(\n    equals(item().type, 'File'),\n    if(\n        contains(json(pipeline().parameters.p_source_options).file_name_pattern, '*'),\n        and(\n            startsWith(item().name, first(split(json(pipeline().parameters.p_source_options).file_name_pattern, '*'))),\n            endsWith(item().name, last(split(json(pipeline().parameters.p_source_options).file_name_pattern, '*')))\n        ),\n        equals(item().name, json(pipeline().parameters.p_source_options).file_name_pattern)\n    )\n)",
            "type": "Expression"
          }
        },
        "name": "flt_candidate_files",
        "dependsOn": [
          {
            "activity": "gm_candidate_files",
            "dependencyConditions": [
              "Succeeded"
            ]
          }
        ]
      },
      {
        "type": "ForEach",
        "typeProperties": {
          "isSequential": true,
          "items": {
            "value": "@activity('flt_candidate_files').output.value",
