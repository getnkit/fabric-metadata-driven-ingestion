                    "type": "Expression"
                  },
                  "p_file_format": {
                    "value": "@pipeline().parameters.p_file_format",
                    "type": "Expression"
                  },
                  "p_source_relative_folder": {
                    "value": "@substring(pipeline().parameters.p_current_source_path, length(pipeline().parameters.p_source_root_path), sub(length(pipeline().parameters.p_current_source_path), length(pipeline().parameters.p_source_root_path)))",
                    "type": "Expression"
                  }
                },
                "waitOnCompletion": true,
                "workspaceId": "00000000-0000-0000-0000-000000000000",
                "pipelineId": "f8a4ca17-735b-4edb-a911-b86d825cadf1",
