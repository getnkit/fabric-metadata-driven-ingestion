          "timeout": "0.12:00:00",
          "retry": 2,
          "retryIntervalInSeconds": 30,
          "secureInput": false,
          "secureOutput": false
        },
        "name": "gm_source_files",
        "dependsOn": []
      },
      {
        "type": "Filter",
        "typeProperties": {
          "items": {
            "value": "@activity('gm_source_files').output.childItems",
            "type": "Expression"
          },
          "condition": {
            "value": "@and(\n    equals(item().type, 'File'),\n    if(\n        contains(@json(pipeline().parameters.p_source_options).file_name_pattern, '*'),\n        and(\n            startsWith(\n                item().name,\n                first(split(@json(pipeline().parameters.p_source_options).file_name_pattern, '*'))\n            ),\n            endsWith(\n                item().name,\n                last(split(@json(pipeline().parameters.p_source_options).file_name_pattern, '*'))\n            )\n        ),\n        equals(\n            item().name,\n            @json(pipeline().parameters.p_source_options).file_name_pattern\n        )\n    )\n)",
            "type": "Expression"
          }
        },
        "name": "flt_candidate_files",
