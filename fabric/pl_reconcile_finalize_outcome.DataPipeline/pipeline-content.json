{
  "properties": {
    "activities": [
      {
        "type": "Lookup",
        "typeProperties": {
          "source": {
            "type": "FabricSqlDatabaseSource",
            "sqlReaderQuery": {
              "value": "@concat(\n    'SELECT COALESCE((',\n    'SELECT CASE ',\n    'WHEN a.status = ''SUCCESS'' THEN ''COMMITTED_SUCCESS'' ',\n    'WHEN a.status = ''FAILED'' AND a.error_code = ''WATERMARK_CONFLICT'' THEN ''CONFIRMED_CONFLICT'' ',\n    'ELSE ''OTHER'' END ',\n    'FROM audit.ingestion_log AS a ',\n    'WHERE a.pipeline_run_id = ''',\n    replace(pipeline().parameters.p_audit_pipeline_run_id, '''', ''''''),\n    ''' AND a.batch_id = TRY_CONVERT(uniqueidentifier, ''',\n    replace(pipeline().parameters.p_batch_id, '''', ''''''),\n    ''') AND a.ingestion_config_id = ',\n    string(pipeline().parameters.p_ingestion_config_id),\n    '), ''OTHER'') AS finalize_outcome;'\n)",
              "type": "Expression"
            },
            "partitionOption": "None",
            "queryTimeout": "02:00:00"
          },
          "datasetSettings": {
            "type": "FabricSqlDatabaseTable",
            "schema": [],
            "connectionSettings": {
              "name": "sqldb_ingestion_control",
              "properties": {
                "type": "FabricSqlDatabase",
                "typeProperties": {
                  "artifactId": "@pipeline().libraryVariables.ingestion_control_item_id",
                  "workspaceId": "@pipeline().libraryVariables.ingestion_control_workspace_id"
                },
                "externalReferences": {
                  "connection": "@pipeline().libraryVariables.ingestion_control_connection_id"
                },
                "annotations": []
              }
            },
            "annotations": []
          },
          "firstRowOnly": true
        },
        "policy": {
          "timeout": "0.12:00:00",
          "retry": 2,
          "retryIntervalInSeconds": 30,
          "secureInput": false,
          "secureOutput": false
        },
        "name": "lkp_finalize_outcome",
        "dependsOn": []
      },
      {
        "type": "Switch",
        "typeProperties": {
          "on": {
            "value": "@if(\n    equals(activity('lkp_finalize_outcome').output.firstRow.finalize_outcome, 'CONFIRMED_CONFLICT'),\n    if(equals(pipeline().parameters.p_ingestion_pattern, 'FILE'), 'CONFIRMED_CONFLICT_FILE', 'CONFIRMED_CONFLICT_DATABASE'),\n    activity('lkp_finalize_outcome').output.firstRow.finalize_outcome\n)",
            "type": "Expression"
          },
          "cases": [
            {
              "value": "CONFIRMED_CONFLICT_DATABASE",
              "activities": [
                {
                  "type": "TridentNotebook",
                  "typeProperties": {
                    "notebookId": "7b8c5a1d-4f23-4c0a-a9e7-21d8b2f4c6a1",
                    "workspaceId": "00000000-0000-0000-0000-000000000000",
                    "parameters": {
                      "p_workspace_id": {
                        "value": {
                          "value": "@json(pipeline().parameters.p_target_connection_settings).workspaceId",
                          "type": "Expression"
                        },
                        "type": "string"
                      },
                      "p_lakehouse_id": {
                        "value": {
                          "value": "@json(pipeline().parameters.p_target_connection_settings).itemId",
                          "type": "Expression"
                        },
                        "type": "string"
                      },
                      "p_batch_id": {
                        "value": {
                          "value": "@pipeline().parameters.p_batch_id",
                          "type": "Expression"
                        },
                        "type": "string"
                      },
                      "p_pipeline_run_id": {
                        "value": {
                          "value": "@pipeline().parameters.p_audit_pipeline_run_id",
                          "type": "Expression"
                        },
                        "type": "string"
                      },
                      "p_target_schema": {
                        "value": {
                          "value": "@pipeline().parameters.p_target_schema",
                          "type": "Expression"
                        },
                        "type": "string"
                      },
                      "p_target_table": {
                        "value": {
                          "value": "@pipeline().parameters.p_target_table",
                          "type": "Expression"
                        },
                        "type": "string"
                      }
                    }
                  },
                  "externalReferences": {
                    "connection": "@pipeline().libraryVariables.notebook_execution_connection_id"
                  },
                  "policy": {
                    "timeout": "0.01:00:00",
                    "retry": 1,
                    "retryIntervalInSeconds": 30,
                    "secureInput": false,
                    "secureOutput": false
                  },
                  "name": "nb_cleanup_bronze_finalize_conflict",
                  "dependsOn": []
                },
                {
                  "type": "Fail",
                  "typeProperties": {
                    "message": "Confirmed WATERMARK_CONFLICT; failed Bronze batch cleaned. Audit remains FAILED; restart with a new top-level REGULAR run.",
                    "errorCode": "WATERMARK_CONFLICT"
                  },
                  "name": "fail_confirmed_watermark_conflict",
                  "dependsOn": [
                    {
                      "activity": "nb_cleanup_bronze_finalize_conflict",
                      "dependencyConditions": [
                        "Succeeded"
                      ]
                    }
                  ]
                },
                {
                  "type": "Fail",
                  "typeProperties": {
                    "message": {
                      "value": "@concat('Confirmed WATERMARK_CONFLICT, but Bronze cleanup failed: ',take(string(activity('nb_cleanup_bronze_finalize_conflict').error.message),1500))",
                      "type": "Expression"
                    },
                    "errorCode": "BRONZE_CLEANUP_FAILED"
                  },
                  "name": "fail_bronze_finalize_cleanup",
                  "dependsOn": [
                    {
                      "activity": "nb_cleanup_bronze_finalize_conflict",
                      "dependencyConditions": [
                        "Failed"
                      ]
                    }
                  ]
                }
              ]
            },
            {
              "value": "CONFIRMED_CONFLICT_FILE",
              "activities": [
                {
                  "type": "TridentNotebook",
                  "typeProperties": {
                    "notebookId": "7b8c5a1d-4f23-4c0a-a9e7-21d8b2f4c6a1",
                    "workspaceId": "00000000-0000-0000-0000-000000000000",
                    "parameters": {
                      "p_workspace_id": {
                        "value": {
                          "value": "@json(pipeline().parameters.p_target_connection_settings).workspaceId",
                          "type": "Expression"
                        },
                        "type": "string"
                      },
                      "p_lakehouse_id": {
                        "value": {
                          "value": "@json(pipeline().parameters.p_target_connection_settings).itemId",
                          "type": "Expression"
                        },
                        "type": "string"
                      },
                      "p_batch_id": {
                        "value": {
                          "value": "@pipeline().parameters.p_batch_id",
                          "type": "Expression"
                        },
                        "type": "string"
                      },
                      "p_pipeline_run_id": {
                        "value": {
                          "value": "@pipeline().parameters.p_audit_pipeline_run_id",
                          "type": "Expression"
                        },
                        "type": "string"
                      },
                      "p_target_schema": {
                        "value": {
                          "value": "@pipeline().parameters.p_target_schema",
                          "type": "Expression"
                        },
                        "type": "string"
                      },
                      "p_target_table": {
                        "value": {
                          "value": "@pipeline().parameters.p_target_table",
                          "type": "Expression"
                        },
                        "type": "string"
                      }
                    }
                  },
                  "externalReferences": {
                    "connection": "@pipeline().libraryVariables.notebook_execution_connection_id"
                  },
                  "policy": {
                    "timeout": "0.01:00:00",
                    "retry": 1,
                    "retryIntervalInSeconds": 30,
                    "secureInput": false,
                    "secureOutput": false
                  },
                  "name": "nb_cleanup_bronze_finalize_conflict_file",
                  "dependsOn": []
                },
                {
                  "type": "TridentNotebook",
                  "typeProperties": {
                    "notebookId": "6c4e51d2-9a37-4b2f-8e61-2d7c0a5f9341",
                    "workspaceId": "00000000-0000-0000-0000-000000000000",
                    "parameters": {
                      "p_workspace_id": {
                        "value": {
                          "value": "@json(pipeline().parameters.p_target_connection_settings).workspaceId",
                          "type": "Expression"
                        },
                        "type": "string"
                      },
                      "p_lakehouse_id": {
                        "value": {
                          "value": "@json(pipeline().parameters.p_target_connection_settings).itemId",
                          "type": "Expression"
                        },
                        "type": "string"
                      },
                      "p_batch_id": {
                        "value": {
                          "value": "@pipeline().parameters.p_batch_id",
                          "type": "Expression"
                        },
                        "type": "string"
                      },
                      "p_pipeline_run_id": {
                        "value": {
                          "value": "@pipeline().parameters.p_audit_pipeline_run_id",
                          "type": "Expression"
                        },
                        "type": "string"
                      },
                      "p_landing_relative_path": {
                        "value": {
                          "value": "@pipeline().parameters.p_landing_relative_path",
                          "type": "Expression"
                        },
                        "type": "string"
                      },
                      "p_ingestion_config_id": {
                        "value": {
                          "value": "@string(pipeline().parameters.p_ingestion_config_id)",
                          "type": "Expression"
                        },
                        "type": "string"
                      }
                    }
                  },
                  "externalReferences": {
                    "connection": "@pipeline().libraryVariables.notebook_execution_connection_id"
                  },
                  "policy": {
                    "timeout": "0.01:00:00",
                    "retry": 1,
                    "retryIntervalInSeconds": 30,
                    "secureInput": false,
                    "secureOutput": false
                  },
                  "name": "nb_cleanup_landing_finalize_conflict",
                  "dependsOn": [
                    {
                      "activity": "nb_cleanup_bronze_finalize_conflict_file",
                      "dependencyConditions": [
                        "Succeeded"
                      ]
                    }
                  ]
                },
                {
                  "type": "Fail",
                  "typeProperties": {
                    "message": "Confirmed WATERMARK_CONFLICT; failed Bronze batch and scoped Landing files cleaned. Audit remains FAILED; restart with a new top-level REGULAR run.",
                    "errorCode": "WATERMARK_CONFLICT"
                  },
                  "name": "fail_confirmed_watermark_conflict_file",
                  "dependsOn": [
                    {
                      "activity": "nb_cleanup_landing_finalize_conflict",
                      "dependencyConditions": [
                        "Succeeded"
                      ]
                    }
                  ]
                },
                {
                  "type": "Fail",
                  "typeProperties": {
                    "message": {
                      "value": "@concat('Confirmed WATERMARK_CONFLICT, but Bronze cleanup failed: ',take(string(activity('nb_cleanup_bronze_finalize_conflict_file').error.message),1500))",
                      "type": "Expression"
                    },
                    "errorCode": "BRONZE_CLEANUP_FAILED"
                  },
                  "name": "fail_bronze_finalize_cleanup_file",
                  "dependsOn": [
                    {
                      "activity": "nb_cleanup_bronze_finalize_conflict_file",
                      "dependencyConditions": [
                        "Failed"
                      ]
                    }
                  ]
                },
                {
                  "type": "Fail",
                  "typeProperties": {
                    "message": {
                      "value": "@concat('Confirmed WATERMARK_CONFLICT; Bronze cleaned, Landing cleanup failed: ',take(string(activity('nb_cleanup_landing_finalize_conflict').error.message),1500))",
                      "type": "Expression"
                    },
                    "errorCode": "LANDING_CLEANUP_FAILED"
                  },
                  "name": "fail_landing_finalize_cleanup",
                  "dependsOn": [
                    {
                      "activity": "nb_cleanup_landing_finalize_conflict",
                      "dependencyConditions": [
                        "Failed"
                      ]
                    }
                  ]
                }
              ]
            },
            {
              "value": "COMMITTED_SUCCESS",
              "activities": [
                {
                  "type": "Fail",
                  "typeProperties": {
                    "message": "Audit confirms SUCCESS for this run. Do NOT cleanup or automatically rerun committed Bronze; investigate failed response.",
                    "errorCode": "FINALIZE_RESPONSE_FAILED_COMMITTED"
                  },
                  "name": "fail_finalize_committed",
                  "dependsOn": []
                }
              ]
            }
          ],
          "defaultActivities": [
            {
              "type": "Fail",
              "typeProperties": {
                "message": "Finalize failed but audit is absent/unexpected. No Bronze or Landing cleanup; reconcile before rerun.",
                "errorCode": "FINALIZE_OUTCOME_UNCONFIRMED"
              },
              "name": "fail_finalize_unconfirmed",
              "dependsOn": []
            }
          ]
        },
        "name": "sw_finalize_outcome",
        "dependsOn": [
          {
            "activity": "lkp_finalize_outcome",
            "dependencyConditions": [
              "Succeeded"
            ]
          }
        ]
      },
      {
        "type": "Fail",
        "typeProperties": {
          "message": {
            "value": "@concat('Finalize failed; audit lookup also failed. No cleanup: ',take(string(activity('lkp_finalize_outcome').error.message),1500))",
            "type": "Expression"
          },
          "errorCode": "FINALIZE_OUTCOME_LOOKUP_FAILED"
        },
        "name": "fail_finalize_outcome_lookup",
        "dependsOn": [
          {
            "activity": "lkp_finalize_outcome",
            "dependencyConditions": [
              "Failed"
            ]
          }
        ]
      }
    ],
    "parameters": {
      "p_ingestion_config_id": {
        "type": "int"
      },
      "p_batch_id": {
        "type": "string"
      },
      "p_audit_pipeline_run_id": {
        "type": "string"
      },
      "p_ingestion_pattern": {
        "type": "string"
      },
      "p_target_connection_settings": {
        "type": "string"
      },
      "p_target_schema": {
        "type": "string"
      },
      "p_target_table": {
        "type": "string"
      },
      "p_landing_relative_path": {
        "type": "string",
        "defaultValue": ""
      }
    },
    "libraryVariables": {
      "ingestion_control_workspace_id": {
        "type": "String",
        "variableName": "ingestion_control_workspace_id",
        "libraryName": "vl_ingestion_connections"
      },
      "ingestion_control_item_id": {
        "type": "String",
        "variableName": "ingestion_control_item_id",
        "libraryName": "vl_ingestion_connections"
      },
      "ingestion_control_connection_id": {
        "type": "String",
        "variableName": "ingestion_control_connection_id",
        "libraryName": "vl_ingestion_connections"
      },
      "notebook_execution_connection_id": {
        "type": "String",
        "variableName": "notebook_execution_connection_id",
        "libraryName": "vl_ingestion_connections"
      }
    }
  }
}
