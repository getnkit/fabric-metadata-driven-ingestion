              "value": "@concat(\n    'SELECT ingestion_config_id ',\n    'FROM control.ingestion_config ',\n    'WHERE (',\n        string(pipeline().parameters.p_config_id),\n        ' = 0 AND is_active = 1',\n    ') OR (',\n        string(pipeline().parameters.p_config_id),\n        ' > 0 AND ingestion_config_id = ',\n        string(pipeline().parameters.p_config_id),\n    ') ',\n    'ORDER BY ingestion_config_id ',\n    'OFFSET ',\n        string(mul(pipeline().parameters.p_page_index, pipeline().parameters.p_page_size)),\n        ' ROWS ',\n    'FETCH NEXT ',\n        string(pipeline().parameters.p_page_size),\n        ' ROWS ONLY;'\n)",
