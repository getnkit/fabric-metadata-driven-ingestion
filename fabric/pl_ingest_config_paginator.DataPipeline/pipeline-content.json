{
  "properties": {
    "activities": [
      {
        "type": "IfCondition",
        "typeProperties": {
          "expression": {
            "value": "@and(greaterOrEquals(pipeline().parameters.p_config_page_size, 1), lessOrEquals(pipeline().parameters.p_config_page_size, 5000))",
            "type": "Expression"
          },
          "ifTrueActivities": [],
          "ifFalseActivities": [
            {
              "type": "Fail",
              "typeProperties": {
                "message": {
                  "value": "@concat('Invalid config page size: ', string(pipeline().parameters.p_config_page_size), '. Supported range is 1..5000; default is 1000.')",
                  "type": "Expression"
                },
                "errorCode": "INVALID_CONFIG_PAGE_SIZE"
              },
              "name": "fail_invalid_config_page_size",
              "dependsOn": []
            }
          ]
        },
        "name": "if_valid_config_page_size",
        "dependsOn": []
      },
      {
        "type": "Lookup",
        "typeProperties": {
          "source": {
            "type": "FabricSqlDatabaseSource",
            "sqlReaderQuery": {
              "value": "@concat(\n    'SELECT ',\n    'CAST((COUNT_BIG(1) + ',\n        string(sub(pipeline().parameters.p_config_page_size, 1)),\n        ') / ',\n        string(pipeline().parameters.p_config_page_size),\n        ' AS int) AS page_count ',\n    'FROM control.ingestion_config ',\n    'WHERE is_active = 1;'\n)",
              "type": "Expression"
            },
            "partitionOption": "None",
            "queryTimeout": "02:00:00"
          },
          "datasetSettings": {
            "type": "FabricSqlDatabaseTable",
            "schema": [],
            "connectionSettings": {
              "name": "sqldb_ingestion_control",
              "properties": {
                "type": "FabricSqlDatabase",
                "typeProperties": {
                  "artifactId": "@pipeline().libraryVariables.ingestion_control_item_id",
                  "workspaceId": "00000000-0000-0000-0000-000000000000"
                },
                "externalReferences": {
                  "connection": "@pipeline().libraryVariables.ingestion_control_connection_id"
                },
                "annotations": []
              }
            },
            "annotations": []
          },
          "firstRowOnly": true
        },
        "policy": {
          "timeout": "0.12:00:00",
          "retry": 2,
          "retryIntervalInSeconds": 30,
          "secureInput": false,
          "secureOutput": false
        },
        "name": "lkp_config_pagination_info",
        "dependsOn": [
          {
            "activity": "if_valid_config_page_size",
            "dependencyConditions": [
              "Succeeded"
            ]
          }
        ]
      },
      {
        "type": "ForEach",
        "typeProperties": {
          "isSequential": true,
          "items": {
            "value": "@range(0, int(activity('lkp_config_pagination_info').output.firstRow.page_count))",
            "type": "Expression"
          },
          "activities": [
            {
              "type": "Lookup",
              "typeProperties": {
                "source": {
                  "type": "FabricSqlDatabaseSource",
                  "sqlReaderQuery": {
                    "value": "@concat(\n    'SELECT ',\n        'ingestion_config_id AS config_id, ',\n        '''REGULAR'' AS run_type ',\n    'FROM control.ingestion_config ',\n    'WHERE is_active = 1 ',\n    'ORDER BY ingestion_config_id ',\n    'OFFSET ',\n        string(mul(item(), pipeline().parameters.p_config_page_size)),\n        ' ROWS ',\n    'FETCH NEXT ',\n        string(pipeline().parameters.p_config_page_size),\n        ' ROWS ONLY;'\n)",
                    "type": "Expression"
                  },
                  "partitionOption": "None",
                  "queryTimeout": "02:00:00"
                },
                "datasetSettings": {
                  "type": "FabricSqlDatabaseTable",
                  "schema": [],
                  "connectionSettings": {
                    "name": "sqldb_ingestion_control",
                    "properties": {
                      "type": "FabricSqlDatabase",
                      "typeProperties": {
                        "artifactId": "@pipeline().libraryVariables.ingestion_control_item_id",
                        "workspaceId": "00000000-0000-0000-0000-000000000000"
                      },
                      "externalReferences": {
                        "connection": "@pipeline().libraryVariables.ingestion_control_connection_id"
                      },
                      "annotations": []
                    }
                  },
                  "annotations": []
                },
                "firstRowOnly": false
              },
              "policy": {
                "timeout": "0.12:00:00",
                "retry": 2,
                "retryIntervalInSeconds": 30,
                "secureInput": false,
                "secureOutput": false
              },
              "name": "lkp_config_page",
              "dependsOn": []
            },
            {
              "type": "InvokePipeline",
              "typeProperties": {
                "parameters": {
                  "p_batch_id": {
                    "value": "@pipeline().parameters.p_batch_id",
                    "type": "Expression"
                  },
                  "p_run_requests": {
                    "value": "@activity('lkp_config_page').output.value",
                    "type": "Expression"
                  }
                },
                "waitOnCompletion": true,
                "workspaceId": "00000000-0000-0000-0000-000000000000",
                "pipelineId": "3b7f2c5e-6a91-4d48-b0e2-7c4f9a1d35b6",
                "operationType": "InvokeFabricPipeline"
              },
              "externalReferences": {
                "connection": "@pipeline().libraryVariables.pipeline_invoke_connection_id"
              },
              "policy": {
                "timeout": "0.12:00:00",
                "retry": 0,
                "retryIntervalInSeconds": 30,
                "secureInput": false,
                "secureOutput": false
              },
              "name": "inv_ingest_config_dispatcher",
              "dependsOn": [
                {
                  "activity": "lkp_config_page",
                  "dependencyConditions": [
                    "Succeeded"
                  ]
                }
              ]
            }
          ]
        },
        "name": "fe_config_pages",
        "dependsOn": [
          {
            "activity": "lkp_config_pagination_info",
            "dependencyConditions": [
              "Succeeded"
            ]
          }
        ]
      }
    ],
    "parameters": {
      "p_batch_id": {
        "type": "string"
      },
      "p_config_page_size": {
        "type": "int",
        "defaultValue": 1000
      }
    },
    "libraryVariables": {
      "ingestion_control_item_id": {
        "type": "String",
        "variableName": "ingestion_control_item_id",
        "libraryName": "vl_ingestion_connections"
      },
      "ingestion_control_connection_id": {
        "type": "String",
        "variableName": "ingestion_control_connection_id",
        "libraryName": "vl_ingestion_connections"
      },
      "pipeline_invoke_connection_id": {
        "type": "String",
        "variableName": "pipeline_invoke_connection_id",
        "libraryName": "vl_ingestion_connections"
      }
    }
  }
}