table LatestSource
	column source_system
		dataType: string
		sourceColumn: source_system
	column batch_id
		dataType: string
		sourceColumn: batch_id
	column source_status
		dataType: string
		sourceColumn: source_status
	column object_count
		dataType: int64
		sourceColumn: object_count
	column success_count
		dataType: int64
		sourceColumn: success_count
	column failed_count
		dataType: int64
		sourceColumn: failed_count
	column skipped_count
		dataType: int64
		sourceColumn: skipped_count
	column source_rows
		dataType: int64
		sourceColumn: source_rows
	column target_rows
		dataType: int64
		sourceColumn: target_rows
	column batch_start_time
		dataType: dateTime
		formatString: "yyyy-mm-dd hh:nn"
		sourceColumn: batch_start_time
	column batch_end_time
		dataType: dateTime
		formatString: "yyyy-mm-dd hh:nn"
		sourceColumn: batch_end_time
	measure 'Source Systems' = COALESCE(COUNTROWS(LatestSource), 0)
	measure 'Failed Sources' = FORMAT(COALESCE(CALCULATE(COUNTROWS(LatestSource), LatestSource[source_status] = "FAILED"), 0), "0")
	measure 'Objects' = COALESCE(SUM(LatestSource[object_count]), 0)
	measure 'Latest Activity (UTC)' = MAX(LatestSource[batch_end_time])
		formatString: "yyyy-mm-dd hh:nn"
	measure 'Last Activity' = IF(ISBLANK(MAX(LatestSource[batch_end_time])), "No runs", FORMAT(MAX(LatestSource[batch_end_time]), "dd MMM yyyy HH:mm", "en-US"))
	measure 'Successful Objects' = COALESCE(SUM(LatestSource[success_count]), 0)
	measure 'Failed Objects' = COALESCE(SUM(LatestSource[failed_count]), 0)
	measure 'Skipped Objects' = COALESCE(SUM(LatestSource[skipped_count]), 0)
	measure 'Valid Source Option' = IF(NOT ISBLANK(SELECTEDVALUE(LatestSource[source_system])), 1, 0)
	partition 'LatestSource' = m
		mode: directQuery
		source =
			let
				Source = Sql.Database(ControlSqlServer, ControlSqlDatabase),
				Data = Source{[Schema="audit", Item="v_monitor_latest_source"]}[Data]
			in
				Data
