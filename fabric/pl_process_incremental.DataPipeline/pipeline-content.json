      {
        "type": "SetVariable",
        "typeProperties": {
          "variableName": "v_advance_watermark",
          "value": {
            "value": "@or(\n    equals(\n        pipeline().parameters.p_run_type,\n        'REGULAR'\n    ),\n    and(\n        equals(\n            pipeline().parameters.p_run_type,\n            'RERUN'\n        ),\n        equals(\n            ticks(pipeline().parameters.p_current_watermark),\n            ticks(pipeline().parameters.p_lower_bound)\n        )\n    )\n)",
            "type": "Expression"
          }
        },
        "policy": {
          "secureInput": false,
          "secureOutput": false
        },
