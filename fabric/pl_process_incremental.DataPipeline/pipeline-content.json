  "properties": {
    "activities": [
      {
        "type": "SetVariable",
        "typeProperties": {
          "variableName": "v_target_path",
          "value": {
            "value": "@concat(\n    pipeline().parameters.p_target_folder,\n    '/incremental/window=',\n    formatDateTime(\n        pipeline().parameters.p_lower_bound,\n        'yyyyMMddTHHmmssfffZ'\n    ),\n    '_',\n    formatDateTime(\n        pipeline().parameters.p_upper_bound,\n        'yyyyMMddTHHmmssfffZ'\n    ),\n    '/run=',\n    pipeline().parameters.p_audit_pipeline_run_id,\n    '/'\n)",
            "type": "Expression"
          }
        },
        "policy": {
          "secureInput": false,
          "secureOutput": false
        },
        "name": "set_target_path",
        "dependsOn": []
      },
      {
        "type": "Copy",
        "typeProperties": {
          "source": {
            "type": "AzureSqlSource",
            "sqlReaderQuery": {
              "value": "@concat(\n    'SELECT * FROM [',\n    pipeline().parameters.p_source_schema,\n    '].[',\n    pipeline().parameters.p_source_object,\n    '] WHERE [',\n    pipeline().parameters.p_watermark_field,\n    '] > CONVERT(datetime2(3), ''',\n    formatDateTime(\n        pipeline().parameters.p_lower_bound,\n        'yyyy-MM-ddTHH:mm:ss.fff'\n    ),\n    ''', 126) AND [',\n    pipeline().parameters.p_watermark_field,\n    '] <= CONVERT(datetime2(3), ''',\n    formatDateTime(\n        pipeline().parameters.p_upper_bound,\n        'yyyy-MM-ddTHH:mm:ss.fff'\n    ),\n    ''', 126);'\n)",
              "type": "Expression"
            },
            "partitionOption": "None",
            "queryTimeout": "02:00:00",
            "datasetSettings": {
              "type": "AzureSqlTable",
              "typeProperties": {
                "database": "sql_ecommerce_db"
              },
              "schema": [],
              "externalReferences": {
                "connection": "8fd436e8-81fc-405f-b36f-e26896f7b3f9"
              },
              "annotations": []
            }
          },
          "sink": {
            "type": "ParquetSink",
            "formatSettings": {
              "type": "ParquetWriteSettings",
              "enableVertiParquet": true
            },
            "storeSettings": {
              "type": "AzureBlobStorageWriteSettings"
            },
            "datasetSettings": {
              "type": "Parquet",
              "typeProperties": {
                "location": {
                  "type": "LakehouseLocation",
                  "folderPath": {
                    "value": "@variables('v_target_path')",
                    "type": "Expression"
                  }
                },
                "compressionCodec": "snappy"
              },
              "schema": [],
              "linkedService": {
                "name": "lh_ecommerce_bronze",
                "properties": {
                  "type": "Lakehouse",
                  "typeProperties": {
                    "artifactId": "70382e50-ac8f-9aee-44d7-a3364bb0a86c",
                    "workspaceId": "00000000-0000-0000-0000-000000000000",
                    "rootFolder": "Files"
                  },
                  "annotations": []
                }
              },
              "annotations": []
            }
          },
          "translator": {
            "type": "TabularTranslator",
            "typeConversion": true,
            "typeConversionSettings": {
              "allowDataTruncation": true,
              "treatBooleanAsNumber": false
            }
          },
          "enableStaging": false
        },
        "policy": {
          "timeout": "0.12:00:00",
          "retry": 0,
          "retryIntervalInSeconds": 30,
          "secureInput": false,
          "secureOutput": false
        },
