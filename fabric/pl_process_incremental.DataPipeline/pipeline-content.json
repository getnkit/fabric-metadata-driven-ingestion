      {
        "type": "Copy",
        "typeProperties": {
          "source": {
            "type": "AzureSqlSource",
            "sqlReaderQuery": {
              "value": "@concat(\n    'SELECT *, ',\n    'CAST(''',\n    pipeline().parameters.p_batch_id,\n    ''' AS VARCHAR(36)) AS [_batch_id], ',\n    'CAST(''',\n    pipeline().parameters.p_audit_pipeline_run_id,\n    ''' AS VARCHAR(100)) AS [_pipeline_run_id], ',\n    'CAST(''',\n    variables('v_ingestion_timestamp'),\n    ''' AS DATETIME2(3)) AS [_ingestion_timestamp] ',\n    'FROM [',\n    pipeline().parameters.p_source_schema,\n    '].[',\n    pipeline().parameters.p_source_object,\n    '] WHERE [',\n    pipeline().parameters.p_watermark_field,\n    '] > CONVERT(datetime2(3), ''',\n    formatDateTime(\n        pipeline().parameters.p_lower_bound,\n        'yyyy-MM-ddTHH:mm:ss.fff'\n    ),\n    ''', 126) AND [',\n    pipeline().parameters.p_watermark_field,\n    '] <= CONVERT(datetime2(3), ''',\n    formatDateTime(\n        pipeline().parameters.p_upper_bound,\n        'yyyy-MM-ddTHH:mm:ss.fff'\n    ),\n    ''', 126);'\n)",
              "type": "Expression"
            },
            "partitionOption": "None",
            "queryTimeout": "02:00:00",
            "datasetSettings": {
              "type": "AzureSqlTable",
              "typeProperties": {
                "database": {
                  "value": "@json(\n    pipeline().parameters.p_source_connection_settings\n).database",
                  "type": "Expression"
                }
              },
              "schema": [],
