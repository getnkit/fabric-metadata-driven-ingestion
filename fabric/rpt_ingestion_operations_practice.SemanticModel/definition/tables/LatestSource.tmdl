table LatestSource
	lineageTag: 9aea5d7c-5256-460e-968b-52300837afa4

	measure 'Source Systems' = COALESCE(COUNTROWS(LatestSource), 0)
		formatString: 0
		lineageTag: 53de1505-275f-4e5a-b72d-cfd58d6049d1

	measure 'Failed Sources' =
			
			COALESCE(
			    SUMX(
			        LatestSource,
			        IF(
			            LatestSource[source_status] = "FAILED",
			            1,
			            0
			        )
			    ),
			    0
			)
		formatString: 0
		lineageTag: c8b2fd1e-c223-4385-b2f2-0e285981caa3

	measure Objects =
			
			COALESCE(
			    SUM(LatestSource[object_count]),
			    0
			)
		formatString: 0
		lineageTag: 91914eae-41fc-48ca-a480-74418da4ab90

	measure 'Latest Activity (UTC)' =
			
			MAX(LatestSource[batch_end_time])
		formatString: yyyy-mm-dd h:nn:ss
		lineageTag: dce74d8c-f803-47e0-b692-72dd834f813b

		annotation PBI_FormatHint = {"isDateTimeCustom":true}

	measure 'Successful Objects' =
			
			COALESCE(
			    SUM(LatestSource[success_count]),
			    0
			)
		formatString: 0
		lineageTag: e24e70c1-cbad-4f48-968f-835c8b725b76

	measure 'Failed Objects' =
			
			COALESCE(
			    SUM(LatestSource[failed_count]),
			    0
			)
		formatString: 0
		lineageTag: 000420ac-a51b-4e38-9ab8-f117518987ad

	measure 'Skipped Objects' =
			
			COALESCE(
			    SUM(LatestSource[skipped_count]),
			    0
			)
		formatString: 0
		lineageTag: a03a80f4-93eb-4162-92c7-c9516d422e76

