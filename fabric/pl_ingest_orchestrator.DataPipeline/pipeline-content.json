{
  "properties": {
    "activities": [
      {
        "type": "SetVariable",
        "typeProperties": {
          "variableName": "v_batch_id",
          "value": {
            "value": "@guid()",
            "type": "Expression"
          }
        },
        "policy": {
          "secureInput": false,
          "secureOutput": false
        },
        "name": "set_batch_id",
        "dependsOn": []
      },
      {
        "type": "IfCondition",
        "typeProperties": {
          "expression": {
            "value": "@and(\n    and(\n        not(empty(pipeline().libraryVariables.control_db_connection_id)),\n        not(empty(pipeline().libraryVariables.control_db_item_id))\n    ),\n    and(\n        not(empty(pipeline().libraryVariables.pipeline_invoke_connection_id)),\n        not(empty(pipeline().libraryVariables.notebook_execution_connection_id))\n    )\n)",
            "type": "Expression"
          },
          "ifTrueActivities": [],
          "ifFalseActivities": [
            {
              "type": "Fail",
              "typeProperties": {
                "message": {
                  "value": "@string('Variable Library vl_ingestion_connections must define nonempty control_db_connection_id, control_db_item_id, pipeline_invoke_connection_id, and notebook_execution_connection_id.')",
                  "type": "Expression"
                },
                "errorCode": "MISSING_RUNTIME_BINDING"
              },
              "name": "fail_missing_runtime_binding",
              "dependsOn": []
            }
          ]
        },
        "name": "if_required_connections_provided",
        "dependsOn": [
          {
            "activity": "set_batch_id",
            "dependencyConditions": [
              "Succeeded"
            ]
          }
        ]
      },
      {
        "type": "IfCondition",
        "typeProperties": {
          "expression": {
            "value": "@greater(length(pipeline().parameters.p_run_requests), 0)",
            "type": "Expression"
          },
          "ifTrueActivities": [
            {
              "type": "SqlServerStoredProcedure",
              "typeProperties": {
                "storedProcedureName": "[control].[usp_validate_run_requests]",
                "storedProcedureParameters": {
                  "run_requests_json": {
                    "value": {
                      "value": "@string(pipeline().parameters.p_run_requests)",
                      "type": "Expression"
                    },
                    "type": "String"
                  }
                }
              },
              "connectionSettings": {
                "name": "sqldb_ingestion_control",
                "properties": {
                  "type": "FabricSqlDatabase",
                  "typeProperties": {
                    "artifactId": "@pipeline().libraryVariables.control_db_item_id",
                    "workspaceId": "00000000-0000-0000-0000-000000000000"
                  },
                  "externalReferences": {
                    "connection": "@pipeline().libraryVariables.control_db_connection_id"
                  },
                  "annotations": []
                }
              },
              "policy": {
                "timeout": "0.12:00:00",
                "retry": 0,
                "retryIntervalInSeconds": 30,
                "secureInput": false,
                "secureOutput": false
              },
              "name": "sp_validate_run_requests",
              "dependsOn": []
            },
            {
              "type": "InvokePipeline",
              "typeProperties": {
                "parameters": {
                  "p_batch_id": {
                    "value": "@variables('v_batch_id')",
                    "type": "Expression"
                  },
                  "p_run_requests": {
                    "value": "@pipeline().parameters.p_run_requests",
                    "type": "Expression"
                  }
                },
                "waitOnCompletion": true,
                "workspaceId": "00000000-0000-0000-0000-000000000000",
                "pipelineId": "3b7f2c5e-6a91-4d48-b0e2-7c4f9a1d35b6",
                "operationType": "InvokeFabricPipeline"
              },
              "externalReferences": {
                "connection": "@pipeline().libraryVariables.pipeline_invoke_connection_id"
              },
              "policy": {
                "timeout": "0.12:00:00",
                "retry": 0,
                "retryIntervalInSeconds": 30,
                "secureInput": false,
                "secureOutput": false
              },
              "name": "inv_ingest_config_dispatcher",
              "dependsOn": [
                {
                  "activity": "sp_validate_run_requests",
                  "dependencyConditions": [
                    "Succeeded"
                  ]
                }
              ]
            }
          ],
          "ifFalseActivities": [
            {
              "type": "InvokePipeline",
              "typeProperties": {
                "parameters": {
                  "p_batch_id": {
                    "value": "@variables('v_batch_id')",
                    "type": "Expression"
                  },
                  "p_config_page_size": {
                    "value": "@pipeline().parameters.p_config_page_size",
                    "type": "Expression"
                  }
                },
                "waitOnCompletion": true,
                "workspaceId": "00000000-0000-0000-0000-000000000000",
                "pipelineId": "7c3d9f21-5a84-4eb7-a2d1-6f0c8e93b451",
                "operationType": "InvokeFabricPipeline"
              },
              "externalReferences": {
                "connection": "@pipeline().libraryVariables.pipeline_invoke_connection_id"
              },
              "policy": {
                "timeout": "0.12:00:00",
                "retry": 0,
                "retryIntervalInSeconds": 30,
                "secureInput": false,
                "secureOutput": false
              },
              "name": "inv_ingest_config_paginator",
              "dependsOn": []
            }
          ]
        },
        "name": "if_explicit_run_requests",
        "dependsOn": [
          {
            "activity": "if_required_connections_provided",
            "dependencyConditions": [
              "Succeeded"
            ]
          }
        ]
      }
    ],
    "parameters": {
      "p_run_requests": {
        "type": "array",
        "defaultValue": []
      },
      "p_config_page_size": {
        "type": "int",
        "defaultValue": 1000
      }
    },
    "variables": {
      "v_batch_id": {
        "type": "String"
      }
    },
    "concurrency": 1,
    "libraryVariables": {
      "control_db_connection_id": {
        "type": "String",
        "variableName": "control_db_connection_id",
        "libraryName": "vl_ingestion_connections"
      },
      "control_db_item_id": {
        "type": "String",
        "variableName": "control_db_item_id",
        "libraryName": "vl_ingestion_connections"
      },
      "pipeline_invoke_connection_id": {
        "type": "String",
        "variableName": "pipeline_invoke_connection_id",
        "libraryName": "vl_ingestion_connections"
      },
      "notebook_execution_connection_id": {
        "type": "String",
        "variableName": "notebook_execution_connection_id",
        "libraryName": "vl_ingestion_connections"
      }
    }
  }
}