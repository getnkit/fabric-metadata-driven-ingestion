{
  "properties": {
    "activities": [
      {
        "type": "SetVariable",
        "typeProperties": {
          "variableName": "v_batch_id",
          "value": {
            "value": "@guid()",
            "type": "Expression"
          }
        },
        "policy": {
          "secureInput": false,
          "secureOutput": false
        },
        "name": "set_batch_id",
        "dependsOn": []
      },
      {
        "type": "IfCondition",
        "typeProperties": {
          "expression": {
            "value": "@and(greaterOrEquals(pipeline().parameters.p_config_page_size, 1), lessOrEquals(pipeline().parameters.p_config_page_size, 5000))",
            "type": "Expression"
          },
          "ifTrueActivities": [],
          "ifFalseActivities": [
            {
              "type": "Fail",
              "typeProperties": {
                "message": {
                  "value": "@concat('Invalid config page size: ', string(pipeline().parameters.p_config_page_size), '. Supported range is 1..5000; default is 1000.')",
                  "type": "Expression"
                },
                "errorCode": "INVALID_CONFIG_PAGE_SIZE"
              },
              "name": "fail_invalid_config_page_size",
              "dependsOn": []
            }
          ]
        },
        "name": "if_valid_config_page_size",
        "dependsOn": [
          {
            "activity": "set_batch_id",
            "dependencyConditions": [
              "Succeeded"
            ]
          }
        ]
      },
      {
        "type": "IfCondition",
        "typeProperties": {
          "expression": {
            "value": "@greater(length(pipeline().parameters.p_run_requests), 0)",
            "type": "Expression"
          },
          "ifTrueActivities": [
            {
              "type": "InvokePipeline",
              "typeProperties": {
                "parameters": {
                  "p_batch_id": {
                    "value": "@variables('v_batch_id')",
                    "type": "Expression"
                  },
                  "p_run_requests": {
                    "value": "@pipeline().parameters.p_run_requests",
                    "type": "Expression"
                  },
                  "p_page_index": {
                    "value": "@int('0')",
                    "type": "Expression"
                  },
                  "p_page_size": {
                    "value": "@pipeline().parameters.p_config_page_size",
                    "type": "Expression"
                  }
                },
                "waitOnCompletion": true,
                "workspaceId": "00000000-0000-0000-0000-000000000000",
                "pipelineId": "3b7f2c5e-6a91-4d48-b0e2-7c4f9a1d35b6",
                "operationType": "InvokeFabricPipeline"
              },
              "externalReferences": {
                "connection": "8812ab7f-ca15-4116-9e1e-df9c91d0eec3"
              },
              "policy": {
                "timeout": "0.12:00:00",
                "retry": 0,
                "retryIntervalInSeconds": 30,
                "secureInput": false,
                "secureOutput": false
              },
              "name": "inv_ingest_explicit_requests",
              "dependsOn": []
            }
          ],
          "ifFalseActivities": [
            {
              "type": "Lookup",
              "typeProperties": {
                "source": {
                  "type": "FabricSqlDatabaseSource",
                  "sqlReaderQuery": {
                    "value": "@concat(\n    'SELECT ',\n    'CAST(COUNT_BIG(1) AS bigint) AS config_count, ',\n    'CAST((COUNT_BIG(1) + ',\n        string(sub(pipeline().parameters.p_config_page_size, 1)),\n        ') / ',\n        string(pipeline().parameters.p_config_page_size),\n        ' AS int) AS page_count ',\n    'FROM control.ingestion_config ',\n    'WHERE is_active = 1;'\n)",
                    "type": "Expression"
                  },
                  "partitionOption": "None",
                  "queryTimeout": "02:00:00"
                },
                "datasetSettings": {
                  "type": "FabricSqlDatabaseTable",
                  "schema": [],
                  "connectionSettings": {
                    "name": "sqldb_ingestion_control",
                    "properties": {
                      "type": "FabricSqlDatabase",
                      "typeProperties": {
                        "artifactId": "50af6a71-1856-904b-4b47-b7169c67fb4e",
                        "workspaceId": "00000000-0000-0000-0000-000000000000"
                      },
                      "externalReferences": {
                        "connection": "d65b2109-99c2-4bde-b50a-db0ebf5093da"
                      },
                      "annotations": []
                    }
                  },
                  "annotations": []
                },
                "firstRowOnly": true
              },
              "policy": {
                "timeout": "0.12:00:00",
                "retry": 2,
                "retryIntervalInSeconds": 30,
                "secureInput": false,
                "secureOutput": false
              },
              "name": "lkp_config_pagination_info",
              "dependsOn": []
            },
            {
              "type": "IfCondition",
              "typeProperties": {
                "expression": {
                  "value": "@greater(int(activity('lkp_config_pagination_info').output.firstRow.config_count), 0)",
                  "type": "Expression"
                },
                "ifTrueActivities": [],
                "ifFalseActivities": [
                  {
                    "type": "Fail",
                    "typeProperties": {
                      "message": {
                        "value": "No active ingestion configurations were found.",
                        "type": "Expression"
                      },
                      "errorCode": "CONFIG_NOT_FOUND"
                    },
                    "name": "fail_config_not_found",
                    "dependsOn": []
                  }
                ]
              },
              "name": "if_configs_found",
              "dependsOn": [
                {
                  "activity": "lkp_config_pagination_info",
                  "dependencyConditions": [
                    "Succeeded"
                  ]
                }
              ]
            },
            {
              "type": "ForEach",
              "typeProperties": {
                "isSequential": true,
                "items": {
                  "value": "@range(0, int(activity('lkp_config_pagination_info').output.firstRow.page_count))",
                  "type": "Expression"
                },
                "activities": [
                  {
                    "type": "InvokePipeline",
                    "typeProperties": {
                      "parameters": {
                        "p_batch_id": {
                          "value": "@variables('v_batch_id')",
                          "type": "Expression"
                        },
                        "p_run_requests": {
                          "value": "@pipeline().parameters.p_run_requests",
                          "type": "Expression"
                        },
                        "p_page_index": {
                          "value": "@item()",
                          "type": "Expression"
                        },
                        "p_page_size": {
                          "value": "@pipeline().parameters.p_config_page_size",
                          "type": "Expression"
                        }
                      },
                      "waitOnCompletion": true,
                      "workspaceId": "00000000-0000-0000-0000-000000000000",
                      "pipelineId": "3b7f2c5e-6a91-4d48-b0e2-7c4f9a1d35b6",
                      "operationType": "InvokeFabricPipeline"
                    },
                    "externalReferences": {
                      "connection": "8812ab7f-ca15-4116-9e1e-df9c91d0eec3"
                    },
                    "policy": {
                      "timeout": "0.12:00:00",
                      "retry": 0,
                      "retryIntervalInSeconds": 30,
                      "secureInput": false,
                      "secureOutput": false
                    },
                    "name": "inv_ingest_config_page_dispatcher",
                    "dependsOn": []
                  }
                ]
              },
              "name": "fe_config_pages",
              "dependsOn": [
                {
                  "activity": "if_configs_found",
                  "dependencyConditions": [
                    "Succeeded"
                  ]
                }
              ]
            }
          ]
        },
        "name": "if_explicit_run_requests",
        "dependsOn": [
          {
            "activity": "if_valid_config_page_size",
            "dependencyConditions": [
              "Succeeded"
            ]
          }
        ]
      }
    ],
    "parameters": {
      "p_run_requests": {
        "type": "array",
        "defaultValue": []
      },
      "p_config_page_size": {
        "type": "int",
        "defaultValue": 1000
      }
    },
    "variables": {
      "v_batch_id": {
        "type": "String"
      }
    },
    "concurrency": 1
  }
}